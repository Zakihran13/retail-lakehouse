# P01 — DuckDB file inside the container
P01_DUCKDB_PATH=/data/retail.duckdb


# P01 — public UCI ZIP; override only if the upstream mirror changes
P01_SOURCE_URL=https://archive.ics.uci.edu/static/public/502/online+retail+ii.zip


# P01 — pinned ZIP SHA-256 (download path only)
P01_SOURCE_SHA256=572e36277c2390fbfde10664750731e0a86f55e33470d91919085f0408e67bfb


# P01 — pinned downloaded-workbook SHA-256; fixtures use tests/fixtures/MANIFEST.yaml
P01_WORKBOOK_SHA256=bcbe73b35f5b7babf197fb0cb983a11f5d9ff929078d4aa53d171b1f2df2e980


# P01 — optional local XLSX override; fixture runs verify the fixture manifest
# P01_SOURCE_PATH=
# P01 — expected latest source date for freshness checks
P01_AS_OF_DATE=2011-12-09


# P01 — rows older than this many days require full-month reconciliation
P01_LATE_LOOKBACK_DAYS=14


# P01 — late-arrival ratio that fails the monthly check
P01_MAX_LATE_RATIO=0.02


# P01 — Dagster home inside the container
P01_DAGSTER_HOME=/opt/dagster/home


# P01 — DuckDB worker threads (keep at 4 on the target laptop)
P01_DUCKDB_THREADS=4


# P01 — log level for ingestion and dbt wrappers
P01_LOG_LEVEL=INFO
